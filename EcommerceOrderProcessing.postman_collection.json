{
  "info": {
    "_postman_id": "a0b1c2d3-e4f5-4678-9012-3456789abcde",
    "name": "Ecommerce Order Processing API",
    "description": "Postman requests for the routes currently exposed by AuthController and OrdersController. Set baseUrl to the running API address. Register a user, then log in; the login test saves the returned JWT as the collection variable token. All order routes require authentication. The controller currently requires authentication, but does not apply role-based authorization to the all-orders or status-update routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"{{fullName}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/Auth/register",
            "description": "Creates a customer account. Registration returns a success message; it does not return a JWT."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const responseBody = pm.response.json();",
                  "    if (responseBody.token) {",
                  "        pm.collectionVariables.set('token', responseBody.token);",
                  "        console.log('JWT saved to collection variable: token');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/Auth/login",
            "description": "Authenticates a user and saves the returned token for subsequent authenticated requests."
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/Auth/me",
            "description": "Returns the authenticated user's profile."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Orders",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/Orders",
            "description": "Creates an order from the authenticated user's existing cart. This endpoint currently has no request body or idempotency-key support."
          },
          "response": []
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/Orders/my-orders"
          },
          "response": []
        },
        {
          "name": "Get Order By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/Orders/{{orderId}}"
          },
          "response": []
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/Orders/cancel/{{orderId}}"
          },
          "response": []
        },
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/Orders/all",
            "description": "The current controller requires authentication but does not enforce a separate administrator role for this route."
          },
          "response": []
        },
        {
          "name": "Get All Orders By Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Orders/all/filter?status={{status}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Orders",
                "all",
                "filter"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "{{status}}"
                }
              ]
            },
            "description": "Valid status values are Pending, Completed, and Cancelled. Leave the status query parameter empty to return all statuses."
          },
          "response": []
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"{{status}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/Orders/{{orderId}}/status",
            "description": "Valid status values are Pending, Completed, and Cancelled. The current controller requires authentication but does not enforce a separate administrator role for this route."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5190",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "email",
      "value": "user@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "ChangeMe123!",
      "type": "string"
    },
    {
      "key": "fullName",
      "value": "Postman Test User",
      "type": "string"
    },
    {
      "key": "phoneNumber",
      "value": "01234567890",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "status",
      "value": "Pending",
      "type": "string"
    }
  ]
}
